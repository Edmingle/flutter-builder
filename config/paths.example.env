# Optional defaults for the Build Server.
# Copy to paths.env and source before running build.sh if desired.
#
#   cp config/paths.example.env config/paths.env
#   source config/paths.env

# For local CLI builds only (API builds send tokens per request):
# export GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxx

# CONFIG_DIR=./config
# OUTPUT=./output
# LOGS=./logs

# Play Store (only needed with --upload on CLI)
# PLAYSTORE_JSON=/secure/path/play-store-service-account.json
# PLAY_TRACK=internal

# Optional — overrides builder.json callback_base_url
# CALLBACK_BASE_URL=http://localhost/

# Repository URL, workspace, callback_base_url → config/builder.json
# Do NOT store github_token / onepub_token in JSON.
